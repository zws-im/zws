{
	"$schema": "https://turbo.build/schema.json",
	"cacheMaxSize": "2GB",
	"globalPassThroughEnv": [
		"DATABASE_URL",
		"REDIS_URL",
		"SENTRY_DSN",
		"GOOGLE_API_KEY",
		"ADMIN_USERNAME",
		"BLOCKED_HOSTNAMES",
		"HOSTNAME",
		"SHORT_CHARS",
		"SHORT_LENGTH",
		"SHORT_REWRITES",
		"SHORTENED_BASE_URL"
	],
	"tasks": {
		"//#format": {
			"cache": false
		},
		"//#knip": {
			"cache": false
		},
		"//#lint": {
			"cache": false
		},
		"build": {
			"dependsOn": ["^build"],
			"env": ["API_URL", "WEBSITE_URL", "NEXT_PUBLIC_API_URL", "NEXT_PUBLIC_WEBSITE_URL"],
			"outputs": [".next/**", "!.next/cache/**", "!.next/dev/**", "dist/**"]
		},
		"test": {
			"cache": false,
			"passThroughEnv": ["CI", "TEST_DATABASE_URL", "TEST_REDIS_URL", "DOCKER_*", "TESTCONTAINERS_*"]
		},
		"test:worker": {
			"cache": false,
			"dependsOn": ["build"]
		}
	}
}
