{
	"name": "zws",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check": "turbo run lint format knip build test test:worker",
		"dev": "pitchfork start --local && pnpm --parallel --recursive dev",
		"format": "oxfmt --check",
		"lint": "oxlint",
		"lint:fix": "oxlint --fix",
		"migrate": "drizzle-kit migrate",
		"migrate:check": "drizzle-kit check",
		"migrate:create": "drizzle-kit generate",
		"test": "turbo run test --",
		"format:fix": "oxfmt",
		"knip": "knip"
	},
	"dependencies": {
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"envalid": "9.0.0"
	},
	"devDependencies": {
		"knip": "6.44.1",
		"oxfmt": "0.75.0",
		"oxlint": "1.90.0",
		"oxlint-tsgolint": "7.0.2005",
		"railway": "3.16.0",
		"turbo": "2.11.10"
	},
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	},
	"packageManager": "pnpm@12.18.0"
}
