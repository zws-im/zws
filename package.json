{
	"name": "zws",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"build": "turbo run build",
		"check": "turbo run lint format build test test:worker",
		"dev": "pitchfork start --local && pnpm --parallel --recursive dev",
		"format": "prettier --check .",
		"format:write": "pnpm run format --write",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"migrate": "drizzle-kit migrate",
		"migrate:check": "drizzle-kit check",
		"migrate:create": "drizzle-kit generate",
		"test": "turbo run test --"
	},
	"dependencies": {
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"envalid": "9.0.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"prettier": "3.9.10",
		"prettier-plugin-packagejson": "3.0.2",
		"prettier-plugin-tailwindcss": "0.8.1",
		"railway": "3.16.0",
		"turbo": "2.11.10"
	},
	"packageManager": "pnpm@12.15.0",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	}
}
