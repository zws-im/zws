{
	"name": "zws",
	"private": true,
	"workspaces": [
		"apps/*"
	],
	"scripts": {
		"build": "turbo run build",
		"dev": "pnpm --parallel --recursive dev",
		"format": "prettier --check .",
		"format:write": "pnpm run format --write",
		"lint": "biome check .",
		"lint:fix": "biome check . --write --unsafe",
		"migrate": "drizzle-kit migrate",
		"migrate:check": "drizzle-kit check",
		"migrate:create": "drizzle-kit generate",
		"test": "pnpm run lint && pnpm run format && turbo run build"
	},
	"dependencies": {
		"drizzle-kit": "1.0.0-rc.5-ab785fc",
		"envalid": "8.2.0"
	},
	"devDependencies": {
		"@biomejs/biome": "2.3.10",
		"prettier": "3.9.6",
		"prettier-plugin-packagejson": "3.0.2",
		"prettier-plugin-tailwindcss": "0.8.1",
		"turbo": "2.10.12"
	},
	"packageManager": "pnpm@12.3.4",
	"devEngines": {
		"runtime": {
			"name": "node",
			"version": "26.x",
			"onFail": "warn"
		}
	}
}
