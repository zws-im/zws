{
	"compilerOptions": {
		"experimentalDecorators": true,
		"forceConsistentCasingInFileNames": true,
		"noUncheckedSideEffectImports": false,
		"paths": {
			"@/*": ["./*"]
		},
		"rootDir": ".",
		"target": "es2022"
	},
	"exclude": ["node_modules"],
	"extends": "@tsconfig/next",
	"include": ["next-env.d.ts", "**/*.ts", "**/*.tsx", ".next/types/**/*.ts", ".next/dev/types/**/*.ts"]
}
