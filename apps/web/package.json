{
	"name": "@zws.im/web",
	"version": "0.0.0-development",
	"private": true,
	"bugs": {
		"url": "https://github.com/zws-im/zws/issues"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/zws-im/zws.git"
	},
	"license": "Apache-2.0",
	"author": {
		"name": "Jonah Snider",
		"email": "jonah@jonah.pw",
		"url": "https://jonahsnider.com"
	},
	"scripts": {
		"build": "NODE_ENV=production next build",
		"build:ci": "NODE_OPTIONS=--max-old-space-size=6144 opennextjs-cloudflare build",
		"cf-typegen": "wrangler types --env-interface CloudflareEnv cloudflare-env.d.ts",
		"deploy": "opennextjs-cloudflare build && opennextjs-cloudflare deploy",
		"dev": "portless zws.im next dev",
		"preview": "opennextjs-cloudflare build && opennextjs-cloudflare preview",
		"start": "next start",
		"test:worker": "NEXT_PUBLIC_API_URL=https://api.zws.im NEXT_PUBLIC_WEBSITE_URL=https://zws.im API_URL=https://api.zws.im pnpm run build:ci && wrangler deploy --dry-run --outdir .open-next/test-worker && node --test tests/worker.test.ts"
	},
	"dependencies": {
		"@heroicons/react": "2.2.0",
		"@opennextjs/cloudflare": "1.20.12",
		"@tailwindcss/postcss": "4.3.3",
		"@tanstack/react-query": "5.104.5",
		"@trpc/client": "11.19.0",
		"@trpc/next": "11.19.0",
		"@trpc/react-query": "11.19.0",
		"@types/node": "26.6.5",
		"@types/react": "19.3.0",
		"@types/react-dom": "19.3.0",
		"@zws.im/api": "workspace:*",
		"apexcharts": "8.3.1",
		"clsx": "2.1.1",
		"framer-motion": "14.4.0",
		"millify": "6.1.0",
		"next": "16.4.2",
		"next-plausible": "4.0.0",
		"react": "19.3.1",
		"react-apexcharts": "2.1.1",
		"react-dom": "19.3.1",
		"swagger-ui-react": "5.34.0",
		"tailwindcss": "4.3.3",
		"typescript": "7.0.2"
	},
	"devDependencies": {
		"@trpc/server": "11.19.0",
		"@tsconfig/next": "2.0.6",
		"@types/swagger-ui-react": "5.18.0",
		"miniflare": "5.20261019.0-beta",
		"wrangler": "^4.83.0"
	},
	"engines": {
		"node": "26.x"
	}
}
